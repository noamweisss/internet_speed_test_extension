{
  "$comment": "Project-level Claude Code hooks. They apply to the main agent and every subagent. Each script explains its rules. Git hooks in .githooks cover non-Claude agents and humans.",
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "bash scripts/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "bash scripts/hooks/guard-bash.sh" } ] },
      { "matcher": "Edit|Write|MultiEdit", "hooks": [ { "type": "command", "command": "bash scripts/hooks/guard-write.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "bash scripts/hooks/stop-check.sh" } ] }
    ]
  }
}
