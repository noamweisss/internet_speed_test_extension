#!/usr/bin/env bash
# Blocks pushes to main and non-fast-forward (history rewriting) pushes.
set -u
while read -r local_ref local_sha remote_ref remote_sha; do
  # P3: no auto-generated branch names. Cloud agent sessions must rename their branch first (AGENTS.md §4).
  if printf '%s' "$remote_ref" | grep -qE '^refs/heads/claude/[a-z]+-[a-z]+-[a-z0-9]{6,}$'; then
    echo "RULE P3: '$remote_ref' is an auto-generated branch name. Rename it: git branch -m <type>/<meaningful-topic> (docs/CONVENTIONS.md)" >&2; exit 1
  fi
  case "$remote_ref" in refs/heads/main|refs/heads/master)
    echo "RULE P1: direct pushes to $remote_ref are not allowed; open a pull request (docs/CONVENTIONS.md)" >&2; exit 1;;
  esac
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ] && [ "$local_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      echo "RULE P2: non-fast-forward push to $remote_ref refused (no history rewriting on shared branches)" >&2; exit 1
    fi
  fi
done
exit 0
